# Docker 构建上下文排除（从仓库根构建：docker build -f deploy/Dockerfile .）
# 与 deploy/.dockerignore 的区别：本文件生效于「根目录作为 build context」的场景。
.dockerignore
.git*
.vscode/
.venv/
venv/
__pycache__/
*.py[cod]
*.so

# 运行数据与本地产物（体积大、含隐私）
log/
weibo/
weibo_data/
Output/
*.bak.*
config/config.json

# 测试与开发工具产物
tests/
docs/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
.pytest_cache/
