# ============================================================
# weibo-crawler 忽略规则
# 原则：只忽略「运行数据、敏感文件、缓存」；
#      代码、文档、配置模板（*.example）、测试一律提交。
# ============================================================

# ---------- 运行数据与输出 ----------
# 默认数据输出目录（weibo_data/）；自定义 output_directory 时请同步修改
weibo_data/
# 旧版默认输出目录名
weibo/
# 自定义为 report 时的输出目录
report/
# 运行日志
log/
# 下载失败清单
not_downloaded.txt
# 评论回填进度文件（自定义输出目录时可能出现在根目录）
comment_backfill_progress_*.json

# ---------- 配置与凭据（敏感，勿提交） ----------
# 实际配置（含 Cookie、账号）；模板 config.json.example 需要提交
config.json
config.json.bak.*
config.json*.bak*
# Cookie 文件（配置项 cookie_file 指向时）
cookies.txt
cookie.txt
# 用户列表与评论者白名单（含真实用户 ID、昵称）
user_id_list*.txt
comment_user_filter.txt
# 评论块备份文件
*.md.bak.*
# 本地文档与部署备份（含现场敏感信息）
Output/
.deploy_backup/
历史下载内容/
# 现场遗留文件
js.json

# ---------- Python 缓存与构建 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
*.tmp
*.log

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.code-workspace

# ---------- 操作系统 ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
